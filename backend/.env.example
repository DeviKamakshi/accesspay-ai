# ==========================================
# AccessPay AI - Backend Environment Configuration
# ==========================================

# Server Settings
HOST=0.0.0.0
PORT=8008
DEBUG=true

# Product Search Provider Configuration (Phase 3)
# Options: 'channel3' (real Channel3 API), 'mock' (deterministic demo catalog), or 'auto'
PRODUCT_PROVIDER=auto
DEMO_MODE=false

# Channel3 API Credentials (Backend-only — NEVER expose in frontend)
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com/v1

# AI Service Configuration (Phase 2)
# Supports Google Gemini and OpenAI models.
# Falls back to deterministic MockAIService if no key is configured.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=auto

# PayPal Sandbox Configuration (Phase 4 — Strictly Sandbox Only, NEVER Live)
# Options for PAYMENT_PROVIDER: 'paypal', 'mock', or 'auto'
PAYMENT_PROVIDER=auto
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional SQLite Database path
# DATABASE_PATH=/path/to/accesspay.db
